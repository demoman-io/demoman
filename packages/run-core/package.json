{
  "name": "@demoman/run-core",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./logo": {
      "types": "./dist/logo.d.ts",
      "default": "./dist/logo.js"
    },
    "./wallpaper": {
      "types": "./dist/wallpaper.d.ts",
      "default": "./dist/wallpaper.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@demoman/compositor": "workspace:*",
    "@demoman/replay-engine": "workspace:*",
    "@demoman/resolver": "workspace:*",
    "@demoman/scene-schema": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser": "3.2.7",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vitest": "3.2.7"
  }
}
