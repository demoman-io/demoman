{
  "scriptVersion": 6,
  "name": "Search, open a ticket, reply",
  "target": "http://127.0.0.1:8130/same-document-app.html",
  "viewport": { "width": 1280, "height": 800 },
  "steps": [
    { "do": "waitForLoad" },
    { "do": "type", "into": { "stableId": "search" }, "text": "grinder" },
    { "do": "click", "on": { "stableId": "ticket" } },
    { "do": "pause", "ms": 400 },
    { "do": "click", "on": { "stableId": "reply" } }
  ]
}
