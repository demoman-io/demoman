{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Demoman",
  "colors": {
    "primary": "#0a0a0a",
    "light": "#fafafa",
    "dark": "#0a0a0a"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0a0a0a"
    }
  },
  "fonts": {
    "family": "Manrope"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://demoman.io"
  },
  "favicon": "/favicon.png",
  "navbar": {
    "links": [
      {
        "label": "demoman.io",
        "href": "https://demoman.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "npx demoman setup",
      "href": "/get-started/install"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "get-started/install",
          "get-started/connect",
          "get-started/first-video",
          "get-started/sign-in",
          "get-started/add-to-repo",
          "get-started/ci"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/flows",
          "concepts/refresh",
          "concepts/run-report"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/prompts",
          "guides/phone-and-tablet",
          "guides/export",
          "guides/pull-requests",
          "studio/overview",
          "studio/editing"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          {
            "group": "CLI",
            "pages": [
              "reference/cli",
              "reference/setup",
              "reference/signin",
              "reference/studio",
              "reference/add",
              "reference/remove",
              "reference/join-flow",
              "reference/refresh",
              "reference/mcp",
              "reference/hook"
            ]
          },
          "reference/demoscript",
          "reference/app-json",
          "reference/accounts-json",
          "reference/refusals",
          "reference/environment"
        ]
      },
      {
        "group": "Security & privacy",
        "pages": [
          "security/data",
          "security/privacy"
        ]
      },
      {
        "group": "Resources",
        "pages": [
          "resources/troubleshooting",
          "resources/changelog",
          "resources/license"
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/demoman-io"
    }
  },
  "description": "Demoman is a video recorder for coding agents and a CI pipeline that keeps every video current.",
  "icons": {
    "library": "lucide"
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/get-started/install"
    },
    {
      "source": "/agents",
      "destination": "/get-started/connect"
    },
    {
      "source": "/guides/authentication",
      "destination": "/get-started/sign-in"
    },
    {
      "source": "/guides/repo-flows",
      "destination": "/get-started/ci"
    },
    {
      "source": "/guides/keep-videos-current",
      "destination": "/get-started/ci"
    },
    {
      "source": "/cli/commands",
      "destination": "/reference/cli"
    }
  ]
}
