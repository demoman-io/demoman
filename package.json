{
  "name": "demoman-monorepo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r build && DEMOMAN_TEST_TIER=full pnpm test:packages && node --test 'scripts/*.test.mjs'",
    "test:fast": "pnpm -r build && DEMOMAN_TEST_TIER=fast pnpm test:packages && node --test 'scripts/*.test.mjs'",
    "test:packages": "pnpm test:light && pnpm test:heavy",
    "test:light": "pnpm -r --workspace-concurrency=2 --filter '!@demoman/runner' --filter '!@demoman/studio' --filter '!@demoman/cli' --filter '!@demoman/compositor' --filter '!@demoman/resolver' --filter '!@demoman/replay-engine' --filter '!@demoman/run-core' test",
    "test:heavy": "pnpm -r --workspace-concurrency=1 --filter @demoman/runner --filter @demoman/studio --filter @demoman/cli --filter @demoman/compositor --filter @demoman/resolver --filter @demoman/replay-engine --filter @demoman/run-core test",
    "test:times": "node scripts/test-times.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "share:measure": "pnpm --filter @demoman/runner share:measure",
    "agent:study": "pnpm --filter @demoman/runner build && pnpm --filter @demoman/mcp build && node apps/runner/dist/compare/agent-study.js",
    "film:compare": "pnpm --filter @demoman/runner build && pnpm --filter @demoman/mcp build && node apps/runner/dist/compare/film-compare.js",
    "docs:live": "node scripts/docs-live.mjs",
    "test:package": "pnpm --filter @demoman/cli build && pnpm --filter @demoman/cli test:package",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13"
  },
  "packageManager": "pnpm@11.21.0"
}
